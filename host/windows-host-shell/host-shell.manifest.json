{
  "contractVersion": "v1",
  "appName": "D & J's Karaoke Host",
  "shellKind": "local-webview-shell",
  "targetPlatform": "windows",
  "uiFrameworkDecision": "Windows WebView2 desktop shell with static local assets first; native packaging and playback are deferred.",
  "liveShowRule": "The live show remains local-first and must not depend on internet, HQ server, OBS, or Replay.",
  "safetyBoundaries": {
    "playsMedia": false,
    "downloadsMedia": false,
    "deletesMedia": false,
    "movesLocalFiles": false,
    "requiresInternetForLiveShow": false,
    "connectsToObs": false,
    "connectsToReplay": false
  },
  "hostShellFeatures": {
    "connectionIndicators": [
      "online",
      "local-only",
      "offline",
      "obs-placeholder",
      "replay-placeholder"
    ],
    "keyboardShortcuts": {
      "enabled": true,
      "helpDialog": true,
      "safeActionsOnly": true
    },
    "settingsPersistence": {
      "enabled": true,
      "storage": "browser-localStorage",
      "safeScope": "display-and-preference-placeholders-only"
    },
    "demoMode": {
      "enabled": true,
      "dataFile": "demo-data/host-demo-data.json",
      "mediaFree": true
    },
    "firstRunSetup": {
      "enabled": true,
      "safePlaceholderOnly": true
    },
    "settingsPlaceholders": {
      "localAuthorizedMediaFolder": "display-only",
      "serverUrl": "display-only",
      "localRequestServer": "display-only"
    },
    "uiScaling": {
      "enabled": true,
      "supportedPercentages": [
        90,
        100,
        110,
        125
      ]
    },
    "statePatterns": {
      "loading": true,
      "empty": true,
      "error": true
    },
    "notifications": {
      "toastRegion": true,
      "localOnly": true
    },
    "confirmationDialogs": {
      "safePatternOnly": true,
      "destructiveActionsEnabled": false
    },
    "safeErrorDialogs": {
      "enabled": true,
      "userSafeCopyOnly": true
    },
    "notificationFollowUp": {
      "enabled": true,
      "activityLogLinked": true
    },
    "activityLogPanel": {
      "enabled": true,
      "localUiOnly": true
    },
    "diagnosticsExport": {
      "placeholderOnly": true,
      "writesFiles": false
    },
    "buildDocumentation": {
      "enabled": true,
      "artifactBuildEnabled": false
    },
    "ciCompileChecks": {
      "enabled": true,
      "script": "scripts/host-shell-static-compile-check.ps1"
    },
    "startupSmokeTest": {
      "enabled": true,
      "script": "scripts/host-shell-startup-smoke-test.ps1"
    },
    "cleanShutdownSmokeTest": {
      "enabled": true,
      "script": "scripts/host-shell-clean-shutdown-smoke-test.ps1"
    },
    "settingsMigrationTest": {
      "enabled": true,
      "script": "scripts/host-settings-migration-smoke-test.ps1"
    },
    "demoModeScreenshotChecklist": {
      "enabled": true,
      "path": "docs/development/windows-host-demo-mode-screenshot-checklist.md"
    },
    "catalogImportWizard": {
      "enabled": true,
      "placeholderOnly": true,
      "scansFolders": false,
      "readsMediaFiles": false,
      "writesCatalogRecords": false,
      "performsRollback": false
    },
    "catalogImportReviewQueue": {
      "enabled": true,
      "manualReviewState": true,
      "skipForNowAction": true
    },
    "catalogImportReviewActions": {
      "enabled": true,
      "placeholderOnly": true,
      "needsManualReviewState": true,
      "skipForNowAction": true,
      "markPreferredVersionAction": true,
      "keepBothVersionsAction": true,
      "mergeDuplicateRecordsPreview": true,
      "safeConfirmationBeforeMerge": true,
      "writesCatalogRecords": false
    },
    "importAuditLog": {
      "enabled": true,
      "placeholderOnly": true,
      "writesAuditRecords": false
    },
    "catalogImportTestFixtures": {
      "enabled": true,
      "containsRealMedia": false,
      "path": "host/windows-host-shell/demo-data/catalog-import-demo-fixtures.json"
    },
    "siglosMigrationWizard": {
      "enabled": true,
      "placeholderOnly": true,
      "readsSiglosExports": false,
      "writesCatalogRecords": false,
      "writesSingerRecords": false,
      "requiresBackupFirstMessaging": true
    },
    "siglosMigrationTestFixtures": {
      "enabled": true,
      "containsRealSiglosExport": false,
      "path": "host/windows-host-shell/demo-data/siglos-export-demo-fixtures.json"
    },
    "singerProfileModelShell": {
      "enabled": true,
      "placeholderOnly": true,
      "privacySafeDefaults": true,
      "writesSingerRecords": false,
      "mergesSingerRecords": false,
      "exposesContactPublicly": false
    },
    "singerProfileTestFixtures": {
      "enabled": true,
      "containsRealSingerData": false,
      "path": "host/windows-host-shell/demo-data/singer-profile-demo-fixtures.json"
    },
    "showSessionRotationShell": {
      "enabled": true,
      "placeholderOnly": true,
      "writesShowSessionRecords": false,
      "writesRotationRecords": false,
      "changesLiveRotation": false
    },
    "showSessionRotationTestFixtures": {
      "enabled": true,
      "path": "host/windows-host-shell/demo-data/show-session-rotation-demo-fixtures.json"
    },
    "rotationActionSessionNotesShell": {
      "enabled": true,
      "placeholderOnly": true,
      "changesLiveRotation": false,
      "writesCompletedPerformanceRecords": false,
      "writesSessionSnapshots": false,
      "persistsAutosave": false
    },
    "rotationActionSessionNotesFixtures": {
      "enabled": true,
      "path": "host/windows-host-shell/demo-data/rotation-actions-demo-fixtures.json"
    },
    "sessionRecoveryShell": {
      "enabled": true,
      "placeholderOnly": true,
      "writesSessionRecords": false,
      "writesRecoveryFiles": false,
      "restoresRealSession": false,
      "discardsRealSession": false
    },
    "sessionRecoveryFixtures": {
      "enabled": true,
      "path": "host/windows-host-shell/demo-data/session-recovery-demo-fixtures.json"
    },
    "playbackControlsShell": {
      "enabled": true,
      "placeholderOnly": true,
      "startsAudio": false,
      "readsMediaFiles": false,
      "changesAudioOutput": false,
      "writesPlaybackState": false
    },
    "playbackControlsFixtures": {
      "enabled": true,
      "path": "host/windows-host-shell/demo-data/playback-controls-demo-fixtures.json"
    },
    "outputControlsShell": {
      "enabled": true,
      "placeholderOnly": true,
      "enumeratesDevices": false,
      "selectsRealOutputDevice": false,
      "accessesMicrophone": false,
      "startsRecording": false,
      "playsAudio": false,
      "readsMediaFiles": false,
      "writesControlState": false
    },
    "outputControlsFixtures": {
      "enabled": true,
      "path": "host/windows-host-shell/demo-data/output-controls-demo-fixtures.json"
    },
    "displayShell": {
      "enabled": true,
      "placeholderOnly": true,
      "opensRealPreviewWindow": false,
      "opensRealExternalWindow": false,
      "entersFullscreen": false,
      "enumeratesDisplays": false,
      "selectsDisplay": false,
      "clonesDisplay": false,
      "loadsBackgroundFiles": false,
      "usesCamera": false,
      "writesDisplayState": false
    },
    "displayShellFixtures": {
      "enabled": true,
      "path": "host/windows-host-shell/demo-data/display-shell-demo-fixtures.json"
    },
    "themeShell": {
      "enabled": true,
      "placeholderOnly": true,
      "loadsLogoFiles": false,
      "loadsBackgroundFiles": false,
      "usesCamera": false,
      "changesRealMonitorState": false,
      "controlsLiveShow": false,
      "readsMediaFiles": false,
      "writesThemeState": false
    },
    "themeShellFixtures": {
      "enabled": true,
      "path": "host/windows-host-shell/demo-data/theme-shell-demo-fixtures.json"
    },
    "hostChecksShell": {
      "enabled": true,
      "placeholderOnly": true,
      "runsRealPlayback": false,
      "controlsLiveShow": false,
      "changesDisplayState": false,
      "reconnectsMonitors": false,
      "registersKeyboardHooks": false,
      "readsMediaFiles": false,
      "writesRuntimeState": false
    },
    "hostChecksFixtures": {
      "enabled": true,
      "path": "host/windows-host-shell/demo-data/host-checks-demo-fixtures.json"
    }
  }
}
