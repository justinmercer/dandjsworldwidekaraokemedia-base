{
  "contractVersion": "v1",
  "appName": "D & J's Karaoke Host",
  "shellKind": "local-webview-shell",
  "targetPlatform": "windows",
  "uiFrameworkDecision": "Windows WebView2 desktop shell with static local assets first; native packaging and playback are deferred.",
  "liveShowRule": "The live show remains local-first and must not depend on internet, HQ server, OBS, or Replay.",
  "safetyBoundaries": {
    "playsMedia": false,
    "downloadsMedia": false,
    "deletesMedia": false,
    "movesLocalFiles": false,
    "requiresInternetForLiveShow": false,
    "connectsToObs": false,
    "connectsToReplay": false
  },
  "hostShellFeatures": {
    "connectionIndicators": [
      "online",
      "local-only",
      "offline",
      "obs-placeholder",
      "replay-placeholder"
    ],
    "keyboardShortcuts": {
      "enabled": true,
      "helpDialog": true,
      "safeActionsOnly": true
    },
    "settingsPersistence": {
      "enabled": true,
      "storage": "browser-localStorage",
      "safeScope": "display-and-preference-placeholders-only"
    },
    "demoMode": {
      "enabled": true,
      "dataFile": "demo-data/host-demo-data.json",
      "mediaFree": true
    },
    "firstRunSetup": {
      "enabled": true,
      "safePlaceholderOnly": true
    },
    "settingsPlaceholders": {
      "localAuthorizedMediaFolder": "display-only",
      "serverUrl": "display-only",
      "localRequestServer": "display-only"
    },
    "uiScaling": {
      "enabled": true,
      "supportedPercentages": [
        90,
        100,
        110,
        125
      ]
    },
    "statePatterns": {
      "loading": true,
      "empty": true,
      "error": true
    },
    "notifications": {
      "toastRegion": true,
      "localOnly": true
    },
    "confirmationDialogs": {
      "safePatternOnly": true,
      "destructiveActionsEnabled": false
    },
    "safeErrorDialogs": {
      "enabled": true,
      "userSafeCopyOnly": true
    },
    "notificationFollowUp": {
      "enabled": true,
      "activityLogLinked": true
    },
    "activityLogPanel": {
      "enabled": true,
      "localUiOnly": true
    },
    "diagnosticsExport": {
      "placeholderOnly": true,
      "writesFiles": false
    },
    "buildDocumentation": {
      "enabled": true,
      "artifactBuildEnabled": false
    },
    "ciCompileChecks": {
      "enabled": true,
      "script": "scripts/host-shell-static-compile-check.ps1"
    },
    "startupSmokeTest": {
      "enabled": true,
      "script": "scripts/host-shell-startup-smoke-test.ps1"
    },
    "cleanShutdownSmokeTest": {
      "enabled": true,
      "script": "scripts/host-shell-clean-shutdown-smoke-test.ps1"
    },
    "settingsMigrationTest": {
      "enabled": true,
      "script": "scripts/host-settings-migration-smoke-test.ps1"
    },
    "demoModeScreenshotChecklist": {
      "enabled": true,
      "path": "docs/development/windows-host-demo-mode-screenshot-checklist.md"
    }
  }
}
