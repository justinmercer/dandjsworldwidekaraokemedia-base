{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dandjs.example/foundation/v1/replay-event.schema.json",
  "title": "Replay Event",
  "description": "Future optional Replay boundary event contract. Replay failures must not interrupt the host.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "v1"
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "showSessionId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "type": "string",
      "enum": ["performance-started", "performance-ended", "request-fulfilled", "show-closed"]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["contractVersion", "eventId", "showSessionId", "eventType", "occurredAt", "payload"]
}
