{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dandjs.example/foundation/v1/host-device.schema.json",
  "title": "Host Device",
  "description": "Safe HQ-side host registration and heartbeat summary for sync planning.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "v1"
    },
    "hostDeviceId": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "venueLabel": {
      "type": ["string", "null"]
    },
    "appVersion": {
      "type": ["string", "null"]
    },
    "localFreeSpaceBytes": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "localLibraryRootReported": {
      "type": "boolean"
    },
    "lastSeenAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "isActive": {
      "type": "boolean"
    },
    "syncState": {
      "type": "string",
      "enum": ["idle", "interrupted", "needs_review"]
    },
    "interruptedSyncState": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "syncId": {
          "type": ["string", "null"]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "lastMediaKey": {
          "type": ["string", "null"]
        },
        "interruptedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "createdAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "updatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "required": [
    "contractVersion",
    "hostDeviceId",
    "displayName",
    "localLibraryRootReported",
    "lastSeenAt",
    "isActive",
    "syncState"
  ]
}
