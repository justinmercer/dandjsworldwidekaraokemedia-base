{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dandjs.example/foundation/v1/show-session.schema.json",
  "title": "Show Session",
  "description": "Host-owned active show state summary for future rotation and recovery workflows.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "v1"
    },
    "showSessionId": {
      "type": "string",
      "minLength": 1
    },
    "hostDeviceId": {
      "type": "string",
      "minLength": 1
    },
    "venueId": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": ["planned", "active", "paused", "closed", "recovered"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rotationSingerIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["contractVersion", "showSessionId", "hostDeviceId", "state", "startedAt", "updatedAt"]
}
