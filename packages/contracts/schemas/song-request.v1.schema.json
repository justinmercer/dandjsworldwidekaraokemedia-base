{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dandjs.example/foundation/v1/song-request.schema.json",
  "title": "Song Request",
  "description": "Future request shape from guest or staff request surfaces to host moderation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "showSessionId": {
      "type": "string",
      "minLength": 1
    },
    "singerId": {
      "type": "string",
      "minLength": 1
    },
    "songId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": ["staff", "guest-web", "host"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "submitted", "approved", "declined", "queued", "performed", "cancelled"]
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "moderatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["contractVersion", "requestId", "showSessionId", "singerId", "songId", "source", "status", "requestedAt"]
}
