{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dandjs.example/foundation/v1/service-health.schema.json",
  "title": "Service Health",
  "description": "Future liveness response contract for server-side services.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "v1"
    },
    "serviceName": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["healthy", "degraded", "unhealthy"]
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    }
  },
  "required": ["contractVersion", "serviceName", "status", "checkedAt"]
}
